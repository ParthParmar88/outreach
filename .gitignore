# ── Secrets ───────────────────────────────────────────────────────────────
# Never commit real credentials. Commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/

# ── Node / frontend ───────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
frontend/dist/
frontend/build/
.vite/
*.tsbuildinfo
.npm/
.eslintcache
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Local data & caches ───────────────────────────────────────────────────
# Corpus dumps, model caches and eval outputs are generated, not source.
*.db
*.sqlite3
data/
.cache/
.models/
backend/eval/output/
backend/eval/runs/
*.parquet

# Evaluation data IS source and must be committed. labels.json is hand-made,
# cannot be regenerated, and is the only ground truth in the repository:
#   backend/eval/data/labels.json      ← commit
#   backend/eval/data/candidates.json  ← commit

# ── Editors & OS ──────────────────────────────────────────────────────────
.claude/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & temp ───────────────────────────────────────────────────────────
*.log
logs/
tmp/
.tmp/

# ── Terraform ─────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
