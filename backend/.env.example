# Copy to .env and edit. Never commit .env.

# ---------------------------------------------------------------- database
# PostgreSQL running natively on this machine (no Docker).
#
# The database and its tables are created on first startup either way. The
# only question is which account the app logs in as.
#
# ── Option A: no setup at all ────────────────────────────────────────────
# Use the superuser the PostgreSQL installer already made. Nothing to create,
# nothing to run. Put the password you chose during installation here:
#
#   DATABASE_URL=postgresql+asyncpg://postgres:YOUR_INSTALL_PASSWORD@localhost:5432/outreach
#
# URL-encode special characters in the password: @ becomes %40, # becomes %23.
# Fine for local development. Never ship a superuser connection to production.
#
# ── Option B: a dedicated role ───────────────────────────────────────────
# Slightly safer, one command. As the postgres superuser, once:
#
#   CREATE ROLE outreach WITH LOGIN CREATEDB PASSWORD 'outreach';
#
# CREATEDB matters — without it the app cannot create its own database.
#
# Option B is the default below. Switch to Option A if you would rather not
# run any SQL at all.
DATABASE_URL=postgresql+asyncpg://outreach:outreach@localhost:5432/outreach

# Create the database if missing and migrate at startup.
# Leave true locally. MUST be false in production: two instances starting
# together would migrate at the same time, and a bad migration should fail
# a deploy rather than the running service.
AUTO_MIGRATE=true

# ---------------------------------------------------------------- app
APP_ENV=local
LOG_LEVEL=INFO

# Allowed browser origin for the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- keys
# Ranking, triage and judging all call OpenAI. Without this a search stops
# with a message saying so.
OPENAI_API_KEY=

# A fine-grained GitHub token with NO scopes is enough: public data only.
# It raises the search limit from 10 requests a minute to 30, and the
# Discussions search does not run without it.
GITHUB_TOKEN=

# ---------------------------------------------------------------- crawling
# Identify ourselves honestly. Put a real contact page here.
USER_AGENT=OutreachBot/0.1 (+https://example.com/bot)

# Seatbelts. Not a target, just a stop line so one enormous docs site
# cannot run for hours.
CRAWL_MAX_PAGES=500
CRAWL_MAX_SECONDS=900
CRAWL_MAX_BYTES=100000000

# Politeness. One page every half second against someone else's server.
CRAWL_DELAY_SECONDS=0.5
HTTP_TIMEOUT_SECONDS=20

# A page with fewer words than this is treated as empty. Usually means the
# site renders with JavaScript and plain fetching cannot read it.
THIN_PAGE_WORDS=120

# ---------------------------------------------------------------- triage
# How many of the best-embedding-ranked posts the cheap title-triage reads
# before the expensive judge picks from them. 0 = read all of them.
#
# Measured trade-off: on a 1,509 candidate run, the ten results a full triage
# produced sat at embedding ranks 51, 105, 182, 141, 87, 169, 80, 3, 44, 57.
# Only one falls inside the top 25, and it was the weakest of the ten.
# Reading everything costs about one extra cent per run.
#
# 300 by measurement: on one real GitHub search, 25 gave 2 usable results and
# 300 gave 4, for half a cent more.
TRIAGE_POOL=300
